# Database — Docker creates this automatically, pick any values
POSTGRES_USER=metriq
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=metriq

# Assembled by docker-compose.yml — don't change the format
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# External API keys — get your own from these services
PAGESPEED_API_KEY=get_from_google_cloud_console
OPENROUTER_API_KEY=get_from_openrouter.ai

# App config
FRONTEND_URL=http://localhost:5173
PORT=4000